{
  "name": "equipment-management-emulator-tests",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:rules": "node --test firestore.test.js",
    "test:auth": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node --test auth-emulator.test.js",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-no-project",
    "test:emulators": "firebase emulators:exec --only auth,firestore --project demo-no-project \"npm run test:rules && npm run test:auth\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "fake-indexeddb": "6.2.5",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.32.1"
  }
}
